# Maintainer: Solomon Choina <shlomochoina@gmail.com>
pkgname=tabby
pkgver=1.0.234
pkgrel=1
pkgdesc="A terminal for a more modern age"
arch=('x86_64')
url="https://tabby.sh"
license=('MIT')
conflicts=('terminus-terminal')
replaces=('terminus-terminal')
depends=('glib2' 'gtk3' 'nss' 'libxcrypt-compat' 'libsecret' 'libnotify')
makedepends=('git' 'yarn' 'python' 'nodejs' 'cmake' 'node-gyp')
source=("git+https://github.com/Eugeny/tabby.git#tag=v$pkgver")
sha256sums=('0244f27b4ab85d423f6f95c7d179c85d54fb51d2128a406bec1c765c4d2a279f')

build(){
  cd "$srcdir/$pkgname/"
  export ARCH=x64
  yarn install
  yarn run build
  ./node_modules/.bin/electron-builder --linux deb
}

package() {
  cd "$srcdir/$pkgname/dist/"
  ar x *.deb
  tar -xf data.tar.xz
  cp -r usr/ "$pkgdir"
  cp -r opt/ "$pkgdir"

  install -Dm755 /dev/stdin "$pkgdir"/usr/bin/"$pkgname" <<END
#!/usr/bin/bash
/opt/Tabby/tabby "\$@"
END
}
